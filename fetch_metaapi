def fetch_metaapi():
    token=os.getenv("METAAPI_TOKEN","").strip()
    acc=os.getenv("METAAPI_ACCOUNT_ID","").strip()
    if not token or not acc: return False
    
    headers={"auth-token": token}
    base=f"https://mt-client-api-v1.london.agiliumtrade.agiliumtrade.ai/users/current/accounts/{acc}"
    
    try:
        # 1. Get ALL symbols your MT5 account has
        url_sym = f"{base}/symbols"
        r = requests.get(url_sym, headers=headers, timeout=10).json()
        # r is list like ["EURUSD","GBPUSD","GOLD","BTCUSD",...] - depends on broker
        symbols = r if isinstance(r, list) else r.get('symbols', [])
        
        if not symbols:
            # fallback list if API returns empty
            symbols = ["XAUUSD","GOLD","XAGUSD","SILVER","EURUSD","GBPUSD","USDJPY","AUDUSD","USDCAD","USDCHF","NZDUSD","EURGBP","EURJPY","GBPJPY","BTCUSD","ETHUSD","US30","NAS100","SPX500","GER40","UK100","WTI","BRENT"]
        
        got = 0
        for s in symbols:
            # skip weird symbols
            if len(s) < 3: continue
            try:
                url = f"{base}/symbols/{s}/current-price"
                data = requests.get(url, headers=headers, timeout=5).json()
                price = data.get('bid') or data.get('ask') or data.get('price')
                if price and float(price) > 0:
                    # Normalize broker names: GOLD->XAUUSD, etc
                    norm = {
                        "GOLD":"XAUUSD", "XAUUSD.a":"XAUUSD", "GOLD.a":"XAUUSD",
                        "SILVER":"XAGUSD", "XAGUSD.a":"XAGUSD",
                        "BTCUSD.a":"BTCUSD", "BTCUSD.a":"BTCUSD"
                    }.get(s, s)
                    # Keep original too so your frontend finds it
                    set_price(s, float(price), True)
                    set_price(norm, float(price), True)
                    got += 1
            except: 
                pass
        
        print(f"MetaApi: got {got}/{len(symbols)} pairs live")
        return got >= 5
        
    except Exception as e:
        print("MetaApi all-pairs fail:", e)
        return False 
